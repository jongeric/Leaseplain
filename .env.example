# ─────────────────────────────────────────────────────────────────────────────
# LeasePlain — Environment Variables
# Copy this file to .env.local for local development
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Claude / Anthropic API ───────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
# Without this, the app falls back to mock analysis data (great for local dev)
ANTHROPIC_API_KEY=

# ─── Auth (better-auth) ───────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=

# GitHub OAuth — create at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — create at https://console.cloud.google.com/
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs — create products at https://dashboard.stripe.com/test/products
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# ─── Cloudflare Bindings ─────────────────────────────────────────────────────
# These are injected automatically in Cloudflare Pages/Workers via wrangler.toml
# DO NOT set these as plain env vars — configure them as bindings in the dashboard
#
# D1 Database binding name: DB
# R2 Bucket binding name:   LEASE_BUCKET
