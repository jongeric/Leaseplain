# ─────────────────────────────────────────────────────────────────────────────
# LeasePlain — Environment Variables
# Copy this file to .env.local for local development
# ─────────────────────────────────────────────────────────────────────────────

# Claude / Anthropic API
# Get your key at https://console.anthropic.com/
# If left empty, the app falls back to mock analysis data (good for local dev)
ANTHROPIC_API_KEY=

# ─── Cloudflare Bindings ─────────────────────────────────────────────────────
# These are injected automatically when running in Cloudflare Pages / Workers.
# You do NOT set them as plain env vars — they are configured in wrangler.toml
# and in the Cloudflare dashboard under "Bindings".

# D1 Database binding name: DB
# R2 Bucket binding name: LEASE_BUCKET

# ─── Stripe (placeholder for future payments) ─────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
